# Telegram — get from my.telegram.org
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash
TELEGRAM_CHANNEL_ID=-100xxxxxxxxx   # channel to monitor

# Google Gemini Vision API — free at aistudio.google.com
GEMINI_API_KEY=your_gemini_key

# CoinSwitch DMA API (regenerate before expiry — keys last 90 days)
COINSWITCH_API_KEY=your_api_key
COINSWITCH_API_SECRET=your_api_secret
COINSWITCH_API_EXPIRY=YYYY-MM-DD   # set via "Reset Expiry" button in Settings after adding new keys

# Web UI — password to access the dashboard
UI_PASSWORD=changeme

# Trading gates
DRY_RUN=true                    # set false to place real orders
LIVE_FROM=2099-01-01            # extra gate: no orders before this date (YYYY-MM-DD)

# Signal parsing: image | text | both
SIGNAL_MODE=image

# Telegram alerts — bot sends trade notifications here
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_ALERT_CHAT_ID=-100xxxxxxxxx
